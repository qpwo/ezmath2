</script><script>
    document.getElementById("copyYear").textContent = new Date().getFullYear();

    function boldLabel(text) {
      var colon = text.textContent.indexOf(":");
      if (colon < 1) return;
      var label = document.createElement("strong");
      label.textContent = text.textContent.slice(0, colon + 1);
      text.textContent = text.textContent.slice(colon + 1);
      text.parentNode.insertBefore(label, text);
    }

    document.querySelectorAll(".card li").forEach(function (item) {
      if (item.firstChild && item.firstChild.nodeType === 3) {
        boldLabel(item.firstChild);
      }
    });

    document.querySelectorAll(".challenge").forEach(function (box) {
      var walker = document.createTreeWalker(box, NodeFilter.SHOW_TEXT);
      var matches = [];
      while (walker.nextNode()) {
        if (/^\s*Ray ID:/.test(walker.currentNode.textContent)) {
          matches.push(walker.currentNode);
        }
      }
      matches.forEach(boldLabel);
    });
  </script>

