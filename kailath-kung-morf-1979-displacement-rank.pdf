<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Verifying your connection :: American Mathematical Society</title>
  <style>* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: sans-serif;
  font-size: 16px;
  line-height: 1.5;
  color: #212529;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  min-height: 100dvh;
}

a {
  color: #0d6efd;
  text-decoration: none;
}

a:hover {
  color: #0a58ca;
}

a[href^="tel:"] {
  white-space: nowrap;
}

header {
  padding: 24px 24px 0;
  text-align: center;
}

.logo {
  display: inline-block;
  width: auto;
  max-width: min(350px, 100%);
  height: auto;
}

.divider {
  height: 0;
  margin: 24px 0 0;
  border: 0;
  border-top: 1px solid #dee2e6;
}

main {
  flex: 1;
  width: 100%;
  max-width: 860px;
  margin: 0 auto;
  padding: 48px 24px 56px;
  text-align: center;
}

h1 {
  font-family: serif;
  font-weight: 500;
  font-size: 52px;
  line-height: 1.2;
  color: #bb5b13;
  margin: 0 0 12px;
}

main p {
  font-size: 20px;
  margin: 0 0 16px;
}

main p.ref {
  font-size: 14px;
  color: #6c757d;
  margin-top: 32px;
}

.card {
  margin: 24px 0;
  padding: 16px;
  overflow-wrap: anywhere;
  border: 1px solid #d3d3d3;
  border-radius: 6px;
  background: #ffffff;
  text-align: left;
}

.card h1,
.card h2,
.card h3 {
  font-family: serif;
  font-weight: 500;
  font-size: 20px;
  line-height: 1.2;
  color: #212529;
  border-left: 3px solid #bb5b13;
  padding-left: 10px;
  margin: 0 0 12px;
}

.card p {
  font-size: 16px;
  margin: 0 0 12px;
}

.card ul {
  margin: 0;
  padding-left: 32px;
  font-size: 16px;
}

.challenge {
  margin: 24px 0;
  font-size: 16px;
}

.challenge h1,
.challenge img {
  display: none;
}

.challenge h2 {
  font-size: 22px;
  margin: 0 0 12px;
}

footer {
  margin: 0 24px;
  padding: 24px 0 16px;
  border-top: 1px solid #dee2e6;
  text-align: center;
}

footer p {
  margin: 0 0 16px;
}

footer small {
  font-size: 14px;
}

.social {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  list-style: none;
  margin: 0 0 12px;
  padding: 0;
}

.social a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  color: #212529;
}

.social a:hover {
  color: #0d6efd;
}

.social svg {
  width: 16px;
  height: 16px;
  fill: currentColor;
}

.trademark {
  max-width: 1020px;
  margin-left: auto;
  margin-right: auto;
}

@media (max-width: 576px) {
  main {
    padding: 32px 20px 48px;
  }

  h1 {
    font-size: 36px;
  }

  main p {
    font-size: 18px;
  }
}
</style>
<meta http-equiv="refresh" content="360"></head>
