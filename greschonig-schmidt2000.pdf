        <div class="colset">
            <div class="main">
                <h2 class="journals-title">
                                            Zawartość tomu 84                                    </h2>
                                <uL class="articles content-list">
                                                                        <li>
                                <div class="info"><a href="pl/wydawnictwa/czasopisma-i-serie-wydawnicze/colloquium-mathematicum/all/84/1/111599/anzelm-iwanik-1946-1998">Anzelm Iwanik (1946-1998)</a>
                                                                            <span class="author">T. Downarowicz, Z. Lipecki</span>
                                                                        <span class="source vol">
                                                                                                                        Colloquium Mathematicum                                                                                                                             84                                                                                                                             (2000),                                                                                    1-12                                                                            </span>
                                                                                                                <span class="source msc">DOI: 10.4064/cm-84/85-1-1-12</span>
                                                                        </div>
                                <div class="action"><a href="pl/wydawnictwa/czasopisma-i-serie-wydawnicze/colloquium-mathematicum/all/84/1/111599/anzelm-iwanik-1946-1998" class="button light view">Szczegóły</a><a
                                        href="/shop/publication/transaction/download/product/111599"
                                        class="button download      free-download"><span>

                                                                                    Pobierz zgodnie z CC-BY                                                                            </span></a></div>
                            </li>
